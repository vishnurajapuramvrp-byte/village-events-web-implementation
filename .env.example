# --- Local (SQLite) ---
DATABASE_URL="file:./dev.db"

# --- Production / Vercel Postgres, Neon, or Supabase ---
# Use the pooled connection for DATABASE_URL and the direct (non-pooled) URL for DIRECT_URL.
# Vercel Postgres: DATABASE_URL=POSTGRES_PRISMA_URL  DIRECT_URL=POSTGRES_URL_NON_POOLED
# Neon: pooled host has -pooler; direct host does not.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Set both Google values to enable Gmail login locally and in production.
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# Gmail that becomes Admin on first Google sign-in. Other Gmail users start as Viewer.
ADMIN_EMAIL="vishnurajapuram.vrp@gmail.com"
# Optional extra Gmail admins, comma-separated
# ADMIN_EMAILS=""

# Login page branding (overrides src/lib/site-config.ts)
VILLAGE_NAME="Vishnu Raja Puram"
# VILLAGE_TAGLINE="Events & Programs"
# VILLAGE_HEADLINE="Festival funds and need-based support for Vishnu Raja Puram."
# VILLAGE_DESCRIPTION="Record donations and expenses for this village’s programmes."

# Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-a-random-string"

# Keep false for Google-only login. Set true only for explicit local demo testing.
ENABLE_DEMO_LOGIN="false"

# Optional labels for `npm run db:seed:prod`
# ORG_NAME="Village Welfare Trust"
# VILLAGE_NAME="Vishnu Raja Puram"
# VILLAGE_DISTRICT="Guntur"
# VILLAGE_STATE="Andhra Pradesh"
