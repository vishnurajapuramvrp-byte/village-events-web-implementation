# SQLite for local/demo. For Vercel, switch prisma provider to postgresql
# and set DATABASE_URL / DIRECT_URL from Neon, Supabase, or Vercel Postgres.
DATABASE_URL="file:./dev.db"
# DIRECT_URL="postgresql://..."

NEXTAUTH_URL="http://localhost:43123"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Optional — omit to use demo email/password accounts from the seed
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails auto-promoted to Admin on first Google sign-in
ADMIN_EMAILS="you@gmail.com"

CRON_SECRET="replace-with-a-random-string"
