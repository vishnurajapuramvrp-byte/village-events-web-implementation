generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  villages  Village[]
}

model Village {
  id             String       @id @default(cuid())
  name           String
  district       String?
  state          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  users          User[]
  people         Person[]
  events         Event[]

  @@index([organizationId])
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String     @default("VIEWER")
  villageId     String?
  village       Village?   @relation(fields: [villageId], references: [id], onDelete: SetNull)
  personId      String?    @unique
  person        Person?    @relation(fields: [personId], references: [id], onDelete: SetNull)
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([villageId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Person {
  id            String         @id @default(cuid())
  villageId     String
  village       Village        @relation(fields: [villageId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  address       String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  distributions Distribution[]

  @@index([villageId])
}

model Event {
  id                  String           @id @default(cuid())
  villageId           String
  village             Village          @relation(fields: [villageId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  startDate           DateTime
  endDate             DateTime?
  openingBalancePaise Int              @default(0)
  year                Int              @default(2026)
  status              String           @default("DRAFT")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  donations           Donation[]
  expenses            Expense[]
  distributions       Distribution[]
  documents           EventDocument[]

  @@index([villageId])
  @@index([villageId, year])
  @@index([status])
}

model Donation {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  donorName      String
  amountPaise    Int
  receivedOn     DateTime
  method         String   @default("CASH")
  transactionRef String?  @unique
  notes          String?
  createdAt      DateTime @default(now())

  @@index([eventId])
}

model Expense {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category    String
  description String
  amountPaise Int
  incurredOn  DateTime
  paidTo      String?
  receiptRef  String?
  createdAt   DateTime @default(now())

  @@index([eventId])
}

model Distribution {
  id                 String                 @id @default(cuid())
  eventId            String
  event              Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId           String
  person             Person                 @relation(fields: [personId], references: [id], onDelete: Restrict)
  principalPaise     Int
  interestMethod     String                 @default("ANNUAL_SIMPLE")
  interestRateBps    Int                    @default(0)
  fixedInterestPaise Int                    @default(0)
  startDate          DateTime
  dueDate            DateTime
  notes              String?
  createdAt          DateTime               @default(now())
  payments           DistributionPayment[]
  reminders          Reminder[]

  @@index([eventId])
  @@index([personId])
  @@index([dueDate])
}

model DistributionPayment {
  id             String       @id @default(cuid())
  distributionId String
  distribution   Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  amountPaise    Int
  paidOn         DateTime
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([distributionId])
}

model Reminder {
  id             String       @id @default(cuid())
  distributionId String
  distribution   Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  kind           String
  scheduledFor   DateTime
  sentAt         DateTime?
  channel        String       @default("LOG")

  @@unique([distributionId, kind])
  @@index([sentAt, scheduledFor])
}

model EventDocument {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title     String
  url       String
  createdAt DateTime @default(now())

  @@index([eventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
